# Copy to .env (never commit it) or put these in the service's environment.
# At least 64 printable characters; e.g. `openssl rand -base64 48` (64 chars).
WAVELET_API_KEY=replace-me-with-at-least-64-random-characters-replace-me-with-at-least-64
SPOTIFY_CLIENT_ID=your-spotify-app-client-id
# Optional: with a client secret the token calls use HTTP Basic client authentication; without one, PKCE alone.
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
PORT=3000
# HOST=0.0.0.0
DATA_DIR=./data
